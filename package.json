{
  "name": "auth-task",
  "private": true,
  "description": "Production-ready sign up / sign in module \u2014 NestJS + MongoDB API, React + TypeScript web app",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @auth/shared build && pnpm -r --parallel --filter ./apps/* --filter @auth/shared dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @auth/shared build && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "pnpm --filter @auth/shared build && pnpm -r test",
    "test:cov": "pnpm --filter @auth/shared build && pnpm -r test:cov",
    "test:e2e": "pnpm --filter @auth/shared build && pnpm --filter @auth/api test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
