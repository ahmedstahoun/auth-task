# Copy to .env and adjust. All values are validated at boot (src/config/env.schema.ts).
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent (defaults: debug in dev, info in prod, silent in test)
# LOG_LEVEL=debug

MONGO_URI=mongodb://127.0.0.1:27017/auth_task

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters and different from each other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=auth-task-api
JWT_AUDIENCE=auth-task-web

# Comma-separated list of allowed browser origins (CORS + CSRF origin check)
CORS_ORIGINS=http://localhost:5173
# Set to true when running behind a reverse proxy / load balancer
TRUST_PROXY=false

# Brute-force protection
AUTH_RATE_LIMIT_PER_MINUTE=5
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_WINDOW_SECONDS=900
